{
	"version": 1,
	"files": ["**/*.md"],
	"textlint": {
		"rules": {
			"preset-ja-technical-writing": true,
			"preset-ja-spacing": true,
			"@textlint-ja/preset-ai-writing": true
		},
		"plugins": { "markdown": true }
	},
	"markdownlint": {
		"config": {
			"default": true,
			"MD013": false
		}
	}
}
